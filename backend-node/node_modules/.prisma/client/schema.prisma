datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique // STUDENT, RECRUITER, COLLEGE_ADMIN
  users User[]
}

model User {
  id               Int               @id @default(autoincrement())
  email            String            @unique
  passwordHash     String
  roleId           Int
  role             Role              @relation(fields: [roleId], references: [id])
  studentProfile   StudentProfile?
  recruiterProfile RecruiterProfile?
  collegeAdmin     CollegeAdmin?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model College {
  id       Int              @id @default(autoincrement())
  name     String           @unique
  admins   CollegeAdmin[]
  students StudentProfile[]
}

model StudentProfile {
  id             Int              @id @default(autoincrement())
  userId         Int              @unique
  user           User             @relation(fields: [userId], references: [id])
  collegeId      Int?
  college        College?         @relation(fields: [collegeId], references: [id])
  firstName      String
  lastName       String
  degree         String?
  graduationYear Int?
  resumeProfile  ResumeProfile?
  applications   JobApplication[]
  savedJobs      SavedJob[]
  roadmapItems   RoadmapItem[]
  interviews     MockInterview[]
}

model RecruiterProfile {
  id          Int     @id @default(autoincrement())
  userId      Int     @unique
  user        User    @relation(fields: [userId], references: [id])
  companyName String
  position    String?
  jobs        Job[]
}

model ResumeProfile {
  id             Int            @id @default(autoincrement())
  studentId      Int            @unique
  student        StudentProfile @relation(fields: [studentId], references: [id])
  skills         String // JSON string or comma separated
  education      String?
  projects       String?
  experience     String?
  certifications String?
  keywords       String?
  preferredRoles String?
  rawText        String? // Full text for AI
  updatedAt      DateTime       @updatedAt
}

model Job {
  id                 Int              @id @default(autoincrement())
  recruiterId        Int
  recruiter          RecruiterProfile @relation(fields: [recruiterId], references: [id])
  title              String
  company            String
  description        String
  requiredSkills     String // JSON string
  preferredSkills    String? // JSON string
  experienceRequired String?
  location           String?
  employmentType     String?
  salary             String?
  status             String           @default("OPEN")
  createdAt          DateTime         @default(now())
  applications       JobApplication[]
  savedBy            SavedJob[]
  drives             PlacementDrive[]
}

model JobApplication {
  id            Int            @id @default(autoincrement())
  jobId         Int
  job           Job            @relation(fields: [jobId], references: [id])
  studentId     Int
  student       StudentProfile @relation(fields: [studentId], references: [id])
  status        String         @default("APPLIED")
  notes         String?
  interviewDate DateTime?
  appliedAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model SavedJob {
  id        Int            @id @default(autoincrement())
  jobId     Int
  job       Job            @relation(fields: [jobId], references: [id])
  studentId Int
  student   StudentProfile @relation(fields: [studentId], references: [id])
  savedAt   DateTime       @default(now())
}

model RoadmapItem {
  id          Int            @id @default(autoincrement())
  studentId   Int
  student     StudentProfile @relation(fields: [studentId], references: [id])
  targetRole  String
  title       String
  description String
  priority    String         @default("MEDIUM") // HIGH, MEDIUM, LOW
  category    String         @default("Programming") // Programming, Cloud, etc.
  status      String         @default("PENDING") // PENDING, COMPLETED
  createdAt   DateTime       @default(now())
}

model MockInterview {
  id         Int                 @id @default(autoincrement())
  studentId  Int
  student    StudentProfile      @relation(fields: [studentId], references: [id])
  jobId      Int?
  type       String // Technical, HR, Project, Resume-based
  difficulty String // Easy, Medium, Hard
  totalScore Int?
  summary    String?
  createdAt  DateTime            @default(now())
  questions  InterviewQuestion[]
}

model InterviewQuestion {
  id            Int           @id @default(autoincrement())
  interviewId   Int
  interview     MockInterview @relation(fields: [interviewId], references: [id])
  question      String
  studentAnswer String?
  aiFeedback    String? // Stored as JSON string
  score         Int?
}

model CollegeAdmin {
  id        Int              @id @default(autoincrement())
  userId    Int              @unique
  user      User             @relation(fields: [userId], references: [id])
  collegeId Int
  college   College          @relation(fields: [collegeId], references: [id])
  drives    PlacementDrive[]
}

model PlacementDrive {
  id              Int          @id @default(autoincrement())
  adminId         Int
  admin           CollegeAdmin @relation(fields: [adminId], references: [id])
  title           String
  company         String
  eligibilityCgpa Float?
  eligibilityDept String?
  deadline        DateTime?
  status          String       @default("ACTIVE") // ACTIVE, CLOSED
  jobId           Int?
  job             Job?         @relation(fields: [jobId], references: [id])
  createdAt       DateTime     @default(now())
}
