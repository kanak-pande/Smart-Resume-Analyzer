# PlacementOS Environment Variables

# --- Server Config ---
PORT=3000

# --- Database ---
# SQLite URL
DATABASE_URL="file:./dev.db"

# --- Security & Auth ---
# Use a strong, random 64-character string in production
# e.g., openssl rand -base64 32
JWT_SECRET=super-secret-placementos-key-change-this-in-prod

# --- External APIs ---
# Gemini API Key for AI Mock Interviews & Job Matching
GEMINI_API_KEY=demo
